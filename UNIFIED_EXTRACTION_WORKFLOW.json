    {"parameters": {"method": "GET","url": "https://discord.com/api/v10/channels/{channel_id}/messages","authentication": "httpHeaderAuth","sendHeaders": true,"headerParameters": {"parameters": [{"name": "Authorization","value": "Bot INSERT_DISCORD_BOT_TOKEN"}]},"queryParameters": {"parameters": [{"name": "limit","value": "100"}]}},"id": "discord-http-node","name": "Discord - Channel Messages","type": "n8n-nodes-base.httpRequest","typeVersion": 4.1,"position": [100, 550]},
    {"parameters": {"operation": "merge"},"id": "node_merge","name": "Merge All Data Sources","type": "n8n-nodes-base.merge","typeVersion": 2.1,"position": [300, 300]},
    {"parameters": {"javaScriptCode": "// Normalize common fields across all sources\nreturn $input.all().map(item => ({\n  id: item.id || item.name || item.title || item.identifier,\n  name: item.name || item.title || item.username,\n  description: item.description || item.bio || item.caption || item.message || item.content,\n  email: item.email || item.contact_email,\n  website: item.website || item.url || item.media_url,\n  industry: item.industry || item.sector || '',\n  funding: item.funding_raised || item.total_raised || 0,\n  team_size: item.team_size || item.employee_count || 0,\n  location: item.location || item.city || item.headquarters_city,\n  country: item.country || item.country_code,\n  source: item.source || 'aggregated',\n  extracted_at: new Date().toISOString()\n}));"},"id": "node_transform","name": "Transform & Normalize Data","type": "n8n-nodes-base.code","typeVersion": 2,"position": [500, 300]},
