{
  "name": "Additional Social Extractions",
  "description": "HTTP node templates for Twitter, Facebook, Instagram, GitHub, Telegram, Discord. CypherHunter not included (no public API).",
  "nodes": [
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.twitter.com/2/users/by/username/{your_username}/tweets",
        "authentication": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization","value": "Bearer INSERT_TWITTER_TOKEN"}]},
        "queryParameters": {"parameters": [{"name": "max_results","value": "100"}]}
      },
      "id": "twitter-http-node",
      "name": "Twitter - User Tweets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v18.0/{page-id}/posts",
        "authentication": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization","value": "Bearer INSERT_FACEBOOK_TOKEN"}]},
        "queryParameters": {"parameters": [
          {"name": "fields", "value": "message,created_time,id"},
          {"name": "limit", "value": "100"}
        ]}
      },
      "id": "facebook-http-node",
      "name": "Facebook - Page Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 250]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.instagram.com/me/media",
        "authentication": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization","value": "Bearer INSERT_INSTAGRAM_TOKEN"}]},
        "queryParameters": {"parameters": [
          {"name": "fields","value": "id,caption,media_url,timestamp"},
          {"name": "limit","value": "100"}
        ]}
      },
      "id": "instagram-http-node",
      "name": "Instagram - Recent Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/users/{github_username}/repos",
        "authentication": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization","value": "Bearer INSERT_GITHUB_TOKEN"}]},
        "queryParameters": {"parameters": [{"name": "per_page","value": "100"}]}
      },
      "id": "github-http-node",
      "name": "GitHub - User Repositories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 550]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.telegram.org/botINSERT_TELEGRAM_BOT_TOKEN/getUpdates",
        "queryParameters": {"parameters": [{"name": "limit","value": "100"}]}
      },
      "id": "telegram-http-node",
      "name": "Telegram - Get Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 700]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://discord.com/api/v10/channels/{channel_id}/messages",
        "authentication": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization","value": "Bot INSERT_DISCORD_BOT_TOKEN"}]},
        "queryParameters": {"parameters": [{"name": "limit","value": "100"}]}
      },
      "id": "discord-http-node",
      "name": "Discord - Channel Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [100, 850]
    }
  ],
  "connections": {},
  "settings": {
    "executionMode": "regular",
    "saveExecutionProgress": true
  }
}
